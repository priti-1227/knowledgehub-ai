generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  fullName  String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  role      Role       @default(EMPLOYEE)
  documents Document[]
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]
}
enum AiIndexStatus {
  AI_PENDING
  AI_PROCESSING
  AI_READY
  AI_FAILED
}
model Document {
  id           String     @id @default(cuid())
  title        String
  originalName String
  fileName     String
  filePath     String
  mimeType     String
  fileSize     Int
  version      Int        @default(1)
  departmentId String
  aiIndexStatus     AiIndexStatus @default(AI_PENDING)

  aiIndexError      String?

  aiIndexedAt       DateTime?

  aiRetryCount      Int           @default(0)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isProcessed  Boolean    @default(false)
  uploadedById String
  department   Department @relation(fields: [departmentId], references: [id])
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
}

